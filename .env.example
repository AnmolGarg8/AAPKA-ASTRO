# ==============================================================================
# AAPKA ASTRO - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development.
# In production (Vercel / Railway / Render / Neon), configure these in your environment dashboard.
# ==============================================================================

# Application & Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL & Prisma ORM)
# Target: Neon, Supabase, Railway, or AWS RDS PostgreSQL
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aapka_astro?schema=public"

# ------------------------------------------------------------------------------
# 2. CACHE, REAL-TIME PRESENCE & LIVE QUEUE (Redis)
# Target: Upstash Redis, Railway, or Render Redis
# Used for: Single-astrologer presence heartbeat, live sorted-set queue position & ETA
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 3. AUTH & SECURITY (Phone OTP & JWT Session Tokens)
# ------------------------------------------------------------------------------
JWT_SECRET="aapka-astro-ultra-secure-jwt-secret-min-32-chars-long"
JWT_EXPIRES_IN="30d"

# ------------------------------------------------------------------------------
# 4. SWAPPABLE OTP PROVIDER (mock | msg91 | twilio | firebase)
# Change OTP_PROVIDER to switch SMS gateway without modifying business logic
# ------------------------------------------------------------------------------
OTP_PROVIDER="mock"

# If using MSG91 (India standard SMS):
MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_TEMPLATE_ID="your_msg91_dlt_approved_template_id"
MSG91_SENDER_ID="APASTRO"

# If using Twilio Verify:
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_SERVICE_SID="your_twilio_verify_service_sid"

# ------------------------------------------------------------------------------
# 5. PAYMENTS (Razorpay Orders API & Webhooks)
# Swappable via PAYMENT_PROVIDER="razorpay" | "mock"
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ------------------------------------------------------------------------------
# 6. VOICE & VIDEO CALLS (Agora RTC / ZegoCloud)
# Swappable via CALL_PROVIDER="agora" | "zegocloud" | "mock"
# ------------------------------------------------------------------------------
CALL_PROVIDER="mock"

# If using Agora (Primary):
AGORA_APP_ID="your_agora_app_id"
AGORA_APP_CERTIFICATE="your_agora_app_certificate"

# If using ZegoCloud:
ZEGOCLOUD_APP_ID="your_zegocloud_app_id"
ZEGOCLOUD_SERVER_SECRET="your_zegocloud_server_secret"

# ------------------------------------------------------------------------------
# 7. FILE & IMAGE STORAGE (Cloudflare R2 / AWS S3)
# Swappable via STORAGE_PROVIDER="r2" | "s3" | "mock"
# Used for: Vastu floor plan blueprints, birth chart PDFs, certified gemstone photos
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="mock"
S3_BUCKET="aapka-astro-production"
S3_REGION="auto"
# For Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_ACCESS_KEY_ID="your_s3_access_key"
S3_SECRET_ACCESS_KEY="your_s3_secret_key"

# ------------------------------------------------------------------------------
# 8. REAL-TIME CHAT & WEBSOCKET GATEWAY (Self-Hosted Socket.io)
# ------------------------------------------------------------------------------
SOCKET_PORT=3001

# ------------------------------------------------------------------------------
# 9. INSTAGRAM GRAPH API & PANCHANG AUTOMATION
# ------------------------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN="your_long_lived_meta_instagram_graph_api_token"
INSTAGRAM_ACCOUNT_ID="your_instagram_business_account_id"

# ------------------------------------------------------------------------------
# 10. BACKGROUND CRON PROTECTION
# ------------------------------------------------------------------------------
CRON_SECRET="your_random_secure_cron_secret_key"
